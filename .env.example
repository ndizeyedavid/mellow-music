MELLOW_REDIS_URL=
REDIS_URL=

# Legacy MySQL (fallback)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Postgres + pgvector (primary on vector branch) — Aiven or local
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=mellow_music
PGSSLMODE=prefer
DB_SSL_CA=

# Groq inference for the mix curator (server-side only, never commit a real key)
GROQ_API_KEY=
# Swappable model, e.g. openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-20b

# Audio resolution without YouTube (datacenter bot checks).
# Optional: base64-encoded Netscape YT-COOKIES file so hosted yt-dlp has
# cookies too (the cookie file itself is gitignored). Generate with:
# base64 -w0 backend/Hidden/YT-COOKIES  (Linux) / certutil -encode (Windows)
YT_COOKIES_B64=
# Optional: HTTP(S) proxy for ALL yt-dlp traffic, e.g. a residential proxy
# when the host network is bot-checked. Format:
# http://user:pass@host:port  (or http://host:port with no auth)
YTDLP_PROXY=
# Daily watchdog notification via ntfy.sh (cron-job.org hits /api/watchdog at 12:00).
# Set to your private topic, e.g. mellow-music-david-xyz789
NTFY_TOPIC=
