MELLOW_REDIS_URL=
REDIS_URL=

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Optional: verify the DB TLS certificate with a CA file (e.g. Aiven ca.pem).
# Unset = encrypted but unverified, which managed hosts accept.
DB_SSL_CA=
# Optional: comma-separated host list overriding the local defaults.
DB_HOSTS=

# Comma-separated web origins allowed to call the API (your Vercel URL).
# Default * keeps local development working.
ALLOWED_ORIGINS=*

# Local dev port (platforms inject PORT automatically).
WEB_PORT=10020

# Fernet key for secure web values (generate per environment).
FERNET_KEY=

# Groq inference for the mix curator (server-side only, never commit a real key)
GROQ_API_KEY=
# Swappable model, e.g. openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-20b

# Audio resolution without YouTube (datacenter bot checks).
# Override only if the default JioSaavn mirror dies.
SAAVN_API_URL=https://jiosaavn-api.vercel.app
# Optional: base64-encoded Netscape YT-COOKIES file so hosted yt-dlp has
# cookies too (the cookie file itself is gitignored). Generate with:
# base64 -w0 backend/Hidden/YT-COOKIES  (Linux) / certutil -encode (Windows)
YT_COOKIES_B64=
